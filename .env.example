# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LinkedIn credentials (used only locally for recruiter search)
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# Search configuration (overrides config/user_profile.json if set)
TARGET_ROLE=Senior Software Engineer
TARGET_LOCATION=United States

# Session cookies — capture from Chrome DevTools → Network tab on each career page
# Meta: visit metacareers.com/jobs, do a search, copy Cookie header from the graphql request
META_COOKIE=
# Apple: visit jobs.apple.com, do a search, copy Cookie header from the role/search request
APPLE_COOKIE=

# Email report delivery via Resend (https://resend.com — free 100/day)
# Sign up → API Keys → create key → paste here
RESEND_API_KEY=re_...
# Recipient address (defaults to LINKEDIN_EMAIL if not set)
REPORT_EMAIL=
